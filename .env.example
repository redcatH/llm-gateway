# llm-gateway 环境变量示例
# 复制为 .env 后填入实际值：cp .env.example .env
# .env 已被 .gitignore 忽略，不会提交到仓库。

# ── 上游地址（至少填一个） ──
# 兜底默认上游；协议专用上游未配置时使用
# 路径重写规则：URL 以 / 结尾时剥离客户端 /v1 前缀拼接到上游路径后
#   例：UPSTREAM_URL=https://host/v2/ + 请求 /v1/messages → 上游 /v2/messages
#   例：UPSTREAM_URL=https://host      + 请求 /v1/messages → 上游 /v1/messages（原样透传）
UPSTREAM_URL=
# OpenAI 协议专用上游（可选，回退 UPSTREAM_URL）
# 同样支持路径重写：以 / 结尾 → 剥离 /v1 前缀拼接
UPSTREAM_OPENAI_URL=
# Anthropic 协议专用上游（可选，回退 UPSTREAM_URL）
# 同样支持路径重写：以 / 结尾 → 剥离 /v1 前缀拼接
UPSTREAM_ANTHROPIC_URL=

# ── 监听 ──
LISTEN_ADDR=:8080
READ_HEADER_TIMEOUT=10s

# ── 连接池 ──
MAX_IDLE_CONNS_PER_HOST=100
IDLE_CONN_TIMEOUT=90s

# ── TLS ──
UPSTREAM_INSECURE_SKIP_VERIFY=false

# ── 代理行为 ──
PRESERVE_HOST=false

# ── 日志 ──
LOG_LEVEL=info
# 非空启用文件日志（同步 stdout + 文件），为空则仅 stdout
LOG_DIR=
LOG_MAX_SIZE=100
LOG_MAX_BACKUPS=7
LOG_MAX_AGE=0
LOG_COMPRESS=true

# ── SSE 拦截 ──
SSE_INTERCEPT_ENABLED=true
SSE_RETRY_AFTER=5
