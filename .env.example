# llm-gateway 环境变量示例
# 复制为 .env 后填入实际值：cp .env.example .env
# .env 已被 .gitignore 忽略，不会提交到仓库。

# ── 上游地址（两个协议上游均必填） ──
# 路径重写规则（按 URL 结尾决定拼接方式）：
#   以 / 结尾 → 剥离客户端 /v1 前缀后拼接（上游路径已含版本号）
#     例：https://host/v2/ + 请求 /v1/messages → 上游 /v2/messages
#   不以 / 结尾 → 上游路径 + 客户端完整路径（上游路径是前缀）
#     例：https://host/anthropic + 请求 /v1/messages → 上游 /anthropic/v1/messages
#   无路径（仅 scheme://host）→ 客户端路径原样透传
#     例：https://host + 请求 /v1/messages → 上游 /v1/messages
UPSTREAM_OPENAI_URL=
UPSTREAM_ANTHROPIC_URL=

# ── 监听 ──
LISTEN_ADDR=:8080
READ_HEADER_TIMEOUT=10s

# ── 连接池 ──
MAX_IDLE_CONNS_PER_HOST=100
IDLE_CONN_TIMEOUT=90s

# ── TLS ──
UPSTREAM_INSECURE_SKIP_VERIFY=false

# ── 代理行为 ──
PRESERVE_HOST=false

# ── 日志 ──
LOG_LEVEL=info
# 非空启用文件日志（同步 stdout + 文件），为空则仅 stdout
LOG_DIR=
LOG_MAX_SIZE=100
LOG_MAX_BACKUPS=7
LOG_MAX_AGE=0
LOG_COMPRESS=true

# ── SSE 拦截 ──
SSE_INTERCEPT_ENABLED=true
SSE_RETRY_AFTER=5
